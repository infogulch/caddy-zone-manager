{
  "name": "upsert-https",
  "description": "Upsert creates an HTTPS record at host5-{{nonce}} (exotic type, compared verbatim).",
  "tier": "advisory",
  "apply_zone": {
    "sync_mode": "upsert",
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.10" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-{{nonce}}" },
      { "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" },
      { "name": "host5-{{nonce}}", "type": "HTTPS", "data": "1 . alpn=h2" }
    ]
  },
  "expect_rr": [{ "name": "host5-{{nonce}}", "type": "HTTPS", "data": "1 . alpn=h2" }]
}
