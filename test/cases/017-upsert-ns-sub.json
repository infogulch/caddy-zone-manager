{
  "name": "upsert-ns-sub",
  "description": "Upsert creates an NS sub-delegation at sub; presence checked via Answer or Authority section.",
  "tier": "advisory",
  "apply_zone": {
    "sync_mode": "upsert",
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.10" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-{{nonce}}" },
      { "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" },
      { "name": "sub-{{nonce}}", "type": "NS", "data": "ns-test.{{zone}}" }
    ]
  },
  "expect_rr": [{ "name": "sub-{{nonce}}", "type": "NS", "data": "ns-test.{{zone}}" }]
}
