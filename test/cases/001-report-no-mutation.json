{
  "name": "report-no-mutation",
  "description": "Report mode plans a create but performs no DNS mutation.",
  "tier": "critical",
  "apply_zone": {
    "sync_mode": "report",
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "ttl": 0, "data": "203.0.113.10" }
    ]
  },
  "absent_rr": [
    { "name": "host1-{{nonce}}", "type": "A" }
  ],
  "expect_sync": { "would_create": 1, "would_delete": 0 }
}
