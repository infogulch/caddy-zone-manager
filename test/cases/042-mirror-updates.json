{
  "name": "mirror-updates",
  "description": "Mirror mode updates host1-{{nonce}} A to a new IP.",
  "tier": "critical",
  "apply_zone": {
    "sync_mode": "mirror",
    "default_ttl": 120000000000,
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.12" },
      { "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" },
      {
        "name": "host6-{{nonce}}",
        "type": "A",
        "ttl": 3600000000000,
        "data": "203.0.113.60"
      },
      { "name": "host7-{{nonce}}", "type": "A", "ttl": 0, "data": "203.0.113.70" },
      { "name": "host8-{{nonce}}", "type": "A", "data": "203.0.113.80" }
    ]
  },
  "expect_rr": [{ "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.12" }]
}
