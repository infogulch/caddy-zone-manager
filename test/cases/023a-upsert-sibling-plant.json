{
  "name": "upsert-sibling-plant",
  "description": "Plant a second TXT sibling at host3-{{nonce}} by declaring both records.",
  "tier": "critical",
  "apply_zone": {
    "sync_mode": "upsert",
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.11" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-updated-{{nonce}}" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-sibling-{{nonce}}" },
      { "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" }
    ]
  },
  "expect_rr": [
    { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-updated-{{nonce}}" },
    { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-sibling-{{nonce}}" }
  ]
}
