{
  "name": "mirror-sibling-plant",
  "description": "Mirror plants two sibling TXT records at host3-{{nonce}} in one reload.",
  "tier": "advisory",
  "apply_zone": {
    "sync_mode": "mirror",
    "records": [
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-keep-{{nonce}}" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-drop-{{nonce}}" }
    ]
  },
  "expect_rr": [
    { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-keep-{{nonce}}" },
    { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-drop-{{nonce}}" }
  ]
}
