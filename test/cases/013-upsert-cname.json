{
  "name": "upsert-cname",
  "description": "Upsert creates a CNAME at host4-{{nonce}} pointing to host1-{{nonce}} in the zone.",
  "tier": "critical",
  "apply_zone": {
    "sync_mode": "upsert",
    "records": [
      { "name": "host1-{{nonce}}", "type": "A", "data": "203.0.113.10" },
      { "name": "host3-{{nonce}}", "type": "TXT", "data": "czm-{{nonce}}" },
      { "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" }
    ]
  },
  "expect_rr": [{ "name": "host4-{{nonce}}", "type": "CNAME", "data": "host1-{{nonce}}.{{zone}}" }]
}
